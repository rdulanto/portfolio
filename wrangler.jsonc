// Configuración del Worker "portfolio" en Cloudflare (Workers Builds la usa al desplegar).
// Los archivos estáticos salen de dist/; solo /api/* pasa por el código del Worker.
// Opcional: el secreto ANTHROPIC_API_KEY (panel de Cloudflare, nunca aquí) cambia el asistente a Claude.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // IA gratuita de Cloudflare (10 000 neuronas al día en el plan gratis).
  "ai": { "binding": "AI" },
  // Máximo 8 preguntas por minuto por IP.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
