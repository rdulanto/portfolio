// Configuración del Worker "portfolio" en Cloudflare (Workers Builds la usa al desplegar).
// Los archivos estáticos salen de dist/; solo /api/* pasa por el código del Worker.
// El secreto ANTHROPIC_API_KEY se define en el panel de Cloudflare, no aquí.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Máximo 8 preguntas por minuto por IP.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
