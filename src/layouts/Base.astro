---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Analytics from '../components/Analytics.astro';
import { ui, type Lang } from '../i18n';
import { SITE, BOOKING } from '../config';
import { paths } from '../data/offer';
import { notesIndex } from '../lib/notes';

interface Props { lang: Lang; title?: string; description?: string; altHref?: string; image?: string }
const { lang, title, description, altHref, image = '/img/ricardo-dulanto.jpg' } = Astro.props;
const t = ui[lang];
const home = lang === 'es' ? '/' : '/en/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { href: paths.consulting(lang), label: t.nav.services },
  { href: paths.courses(lang), label: t.nav.courses },
  { href: paths.projects(lang), label: t.nav.projects },
  { href: notesIndex(lang), label: t.nav.notes },
  { href: paths.roles(lang), label: t.nav.roles },
  { href: paths.about(lang), label: t.nav.about },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ?? t.htmlTitle}</title>
  <meta name="description" content={description ?? t.description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={new URL(lang === 'es' ? Astro.url.pathname : (altHref ?? '/'), Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? Astro.url.pathname : (altHref ?? '/en/'), Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title ?? t.htmlTitle} />
  <meta property="og:description" content={description ?? t.description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#11181C" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    // Aplica el tema elegido antes de pintar, para que no parpadee.
    try { const th = localStorage.getItem('theme'); if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th; } catch {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Ricardo Dulanto Ramírez',
    jobTitle: t.eyebrow, url: Astro.site?.toString(), sameAs: ['https://www.linkedin.com/in/rdulanto/', 'https://github.com/rdulanto'],
    knowsAbout: ['Artificial Intelligence', 'Machine Learning', 'Data Governance', 'MLOps', 'Microsoft Azure'],
  })} />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="top">
    <div class="wrap bar">
      <Logo href={home} />
      <nav class="desk" aria-label={t.nav.label}>
        {links.map((l) => <a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <div class="tools">
        <a href={altHref ?? t.switchHref} class="icon-btn lang" hreflang={lang === 'es' ? 'en' : 'es'} aria-label={t.switchLabel}>{t.switchLang}</a>
        <button type="button" class="icon-btn theme" data-theme-toggle aria-label={t.themeLabel} title={t.themeLabel}>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <a class="btn btn-primary head-cta" href={BOOKING} rel="noopener" target="_blank">{t.ctaShort}</a>
        <details class="menu">
          <summary class="icon-btn" aria-label={t.nav.menu}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </summary>
          <nav class="sheet" aria-label={t.nav.label}>
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
            <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{t.ctaShort}</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="wrap foot">
      <div class="foot-id">
        <Logo href={home} />
        <p>{t.footerTag}</p>
      </div>
      <nav class="foot-links" aria-label={t.nav.footer}>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        <a href={SITE.github} rel="noopener" target="_blank">GitHub</a>
      </nav>
      <p class="legal">© {new Date().getFullYear()} Ricardo Dulanto · {t.footer}</p>
    </div>
  </footer>
  <Analytics lang={lang} />
  <script>
    const root = document.documentElement;
    const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const sync = () => btn?.setAttribute('aria-pressed', String(isDark()));
    sync();
    btn?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      sync();
    });
    // Cierra el menú móvil al elegir un enlace.
    document.querySelectorAll<HTMLAnchorElement>('.menu .sheet a').forEach((a) =>
      a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')));
  </script>
</body>
</html>
<style>
  .skip { position: absolute; left: 16px; top: -80px; min-height: 48px; display: inline-flex; align-items: center; z-index: 30; background: var(--card); padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line); }
  .skip:focus { top: 12px; }
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; height: var(--header); }
  .bar :global(.logo) { margin-right: auto; }
  .desk { display: flex; gap: 4px; align-items: center; }
  .desk a { color: var(--muted); text-decoration: none; font-size: .92rem; font-weight: 500; padding: 12px 12px; border-radius: 999px; transition: color .15s ease, background-color .15s ease; }
  .desk a[aria-current="page"] { color: var(--ink); }
  .desk a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 8px; }
  @media (hover: hover) and (pointer: fine) { .desk a:hover { color: var(--ink); background: var(--sand); } }
  .tools { display: flex; align-items: center; gap: 4px; }
  .icon-btn { display: inline-grid; place-items: center; min-width: 44px; height: 44px; padding: 0 8px; border-radius: 999px; border: 0; background: transparent; color: var(--muted); font: 600 .85rem/1 inherit; font-family: inherit; text-decoration: none; cursor: pointer; transition: color .15s ease, background-color .15s ease, transform .12s var(--ease-out); }
  .icon-btn:active { transform: scale(0.95); }
  @media (hover: hover) and (pointer: fine) { .icon-btn:hover { color: var(--ink); background: var(--sand); } }
  .theme .moon { display: none; }
  :global([data-theme="dark"]) .theme .sun { display: none; }
  :global([data-theme="dark"]) .theme .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme .sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme .moon { display: block; }
  }
  .head-cta { margin-left: 8px; padding: 8px 16px; font-size: .88rem; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .sheet { position: absolute; right: 0; top: calc(100% + 8px); width: min(280px, calc(100vw - 32px)); display: grid; gap: 4px; padding: 12px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 16px 40px -20px rgb(0 0 0 / .35); transform-origin: top right; animation: pop .18s var(--ease-out); }
  .sheet a:not(.btn) { color: var(--ink); text-decoration: none; padding: 12px; border-radius: 8px; min-height: 44px; }
  .sheet a:not(.btn):hover { background: var(--sand); }
  .sheet .btn { margin-top: 8px; }
  @keyframes pop { from { opacity: 0; transform: scale(0.96) translateY(-4px); } }

  footer { border-top: 1px solid var(--line); padding: 48px 0 32px; color: var(--muted); font-size: .9rem; }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: 24px 48px; align-items: start; }
  .foot-id p { margin: 8px 0 0; max-width: 40ch; }
  .foot-links { display: flex; gap: 0 20px; flex-wrap: wrap; justify-content: flex-end; }
  .foot-links a { color: var(--ink); text-decoration: none; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }
  .foot-links a:hover { color: var(--accent); }
  .legal { grid-column: 1 / -1; margin: 8px 0 0; padding-top: 24px; border-top: 1px solid var(--line); font-size: .82rem; }

  @media (max-width: 1180px) { .desk { display: none; } .menu { display: block; } }
  @media (max-width: 520px) { .head-cta { display: none; } .bar { gap: 8px; } .foot { grid-template-columns: 1fr; } }
</style>
