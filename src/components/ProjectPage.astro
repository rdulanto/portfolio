---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n';
const { entry, altHref } = Astro.props;
const lang = entry.data.lang as Lang;
const t = ui[lang];
const { Content } = await render(entry);
const home = lang === 'es' ? '/proyectos/' : '/en/projects/';
---
<Base lang={lang} title={`${entry.data.title} · Ricardo Dulanto`} description={entry.data.summary} altHref={altHref} image={entry.data.image}>
  <article class="wrap article">
    <a href={home} class="back link">{t.back}</a>
    <p class="meta">{entry.data.tags.join(' · ')}</p>
    <h1>{entry.data.question}</h1>
    <p class="summary">{entry.data.summary}</p>
    {entry.data.kpi && (
      <p class="kpi"><strong class="num hl">{entry.data.kpi}</strong><span>{entry.data.kpiText}</span></p>
    )}
    <div class="links">
      {entry.data.demo && <a class="btn btn-primary" href={entry.data.demo} rel="noopener" target="_blank">{t.demo} <span class="arrow" aria-hidden="true">→</span></a>}
      {entry.data.repo && <a class={`btn ${entry.data.demo ? 'btn-ghost' : 'btn-primary'}`} href={entry.data.repo} rel="noopener" target="_blank">{t.code}</a>}
    </div>
    {entry.data.image && <div class="shot"><img src={entry.data.image} alt={entry.data.title} /></div>}
    {entry.data.pipeline.length > 0 && (
      <section class="arch" aria-labelledby="arch-title">
        <h2 id="arch-title">{t.archTitle}</h2>
        <ol class="flow">
          {entry.data.pipeline.map((s, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')} · {s.k}</span>
              <strong>{s.t}</strong>
              <span class="d">{s.d}</span>
            </li>
          ))}
        </ol>
        {entry.data.stack.length > 0 && (
          <p class="stack"><span class="mono">{t.stackTitle}</span>{entry.data.stack.map((x) => <span class="tag">{x}</span>)}</p>
        )}
      </section>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .article { max-width: 780px; padding-top: 40px; padding-bottom: 96px; }
  .back { margin-bottom: 16px; }
  .meta { margin: 0; color: var(--muted); font-size: .8rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  h1 { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 16px; text-wrap: balance; }
  .summary { font-size: 1.15rem; line-height: 1.55; color: var(--muted); margin: 0 0 24px; max-width: 65ch; }
  .kpi { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin: 0; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .kpi strong { font-size: 1.75rem; font-weight: 650; letter-spacing: -0.02em; line-height: 1.15; }
  .kpi span { color: var(--muted); font-size: .95rem; }
  .links { display: flex; gap: 12px; margin: 24px 0 40px; flex-wrap: wrap; }
  .shot { border-radius: var(--radius); border: 1px solid var(--line); overflow: hidden; margin-bottom: 48px; background: #fff; }
  :global([data-theme="dark"]) .shot img { filter: brightness(.85); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .shot img { filter: brightness(.85); } }
  .arch { padding: 0; border: 0; margin: 0 0 48px; }
  .arch h2 { font-size: 1.35rem; margin: 0 0 20px; }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: 24px; counter-reset: s; }
  .flow li { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .flow li + li::before { content: '→'; position: absolute; left: -20px; top: 50%; transform: translateY(-50%); color: var(--accent); font-weight: 600; font-size: .95rem; line-height: 1; }
  .flow .mono { color: var(--accent); }
  .flow strong { font-size: .95rem; font-weight: 600; line-height: 1.35; }
  .flow .d { color: var(--muted); font-size: .85rem; line-height: 1.45; }
  .stack { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; margin: 16px 0 0; }
  .stack .mono { margin-right: 12px; }
  .prose { max-width: 65ch; }
  .prose :global(h3) { font-size: 1.05rem; margin: 1.8em 0 .4em; }
  .prose :global(pre) { font-family: var(--mono); font-size: .82rem; line-height: 1.6; background: var(--sand) !important; color: var(--ink) !important; border: 1px solid var(--line); border-radius: 8px; padding: 16px; overflow-x: auto; }
  .prose :global(pre span) { color: inherit !important; }
  .prose :global(:not(pre) > code) { font-family: var(--mono); font-size: .85em; background: var(--sand); padding: 1px 6px; border-radius: 4px; }
  .prose :global(h2) { font-size: 1.35rem; margin-top: 2.2em; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: .95rem; margin: 16px 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { color: var(--muted); font-weight: 600; font-size: .85rem; }
  @media (max-width: 720px) {
    .links .btn { width: 100%; }
    .flow { grid-auto-flow: row; grid-template-columns: 1fr; gap: 20px; }
    .flow li + li::before { content: '↓'; left: 24px; top: -17px; transform: none; }
  }
</style>
