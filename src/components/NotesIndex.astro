---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n';
import { publishedNotes, notePath } from '../lib/notes';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const notes = await publishedNotes(lang);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-PE' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base lang={lang} title={`${t.notesTitle} · Ricardo Dulanto`} description={t.notesLead} altHref={lang === 'es' ? '/en/blog/' : '/blog/'}>
  <section class="wrap list">
    <p class="eyebrow">Blog</p>
    <h1>{t.notesTitle}</h1>
    <p class="lead">{t.notesLead}</p>
    {notes.length === 0 && <p>{lang === 'es' ? 'El primer artículo llega muy pronto.' : 'The first article is coming soon.'}</p>}
    {notes.map((n) => (
      <a class="item" href={notePath(lang, n.data.slug)}>
        <p class="mono"><span class="cat">{t.cats[n.data.category]}</span> · <time datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time></p>
        <h2>{n.data.title}{n.data.draft && <span class="tag">draft</span>}</h2>
        <p>{n.data.summary}</p>
      </a>
    ))}
  </section>
</Base>
<style>
  .list { max-width: 780px; padding-top: 56px; padding-bottom: 96px; border-top: 0; }
  h1 { font-size: clamp(2.25rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.03em; }
  .lead { margin-bottom: 40px; }
  .item { display: block; text-decoration: none; color: inherit; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .item h2 { font-size: 1.3rem; margin: 6px 0 8px; }
  .item h2 { transition: color .15s ease; }
  @media (hover: hover) and (pointer: fine) { .item:hover h2 { color: var(--accent); } }
  .item p { color: var(--muted); margin: 0; }
  .mono { margin: 0; }
  .cat { color: var(--accent); }
</style>
