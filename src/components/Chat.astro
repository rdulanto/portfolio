---
// Asistente del sitio. Responde con el contenido publicado (ver worker/index.ts).
// No guarda nada: la conversación vive en la memoria de la pestaña y se pierde al cerrarla.
import { ui, type Lang } from '../i18n';
import { BOOKING } from '../config';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].chat;
const cfg = { lang, booking: BOOKING, thinking: t.thinking, error: t.error, limit: t.limit, book: t.book };
---
<div class="chat" data-chat>
  <script type="application/json" set:html={JSON.stringify(cfg)} />
  <button type="button" class="chat-fab" aria-expanded="false" aria-controls="chat-panel" data-chat-open>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 5h14v10H9l-4 4V5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    <span>{t.open}</span>
  </button>

  <div id="chat-panel" class="chat-panel" role="dialog" aria-labelledby="chat-title" hidden>
    <header class="chat-head">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="chat-title">{t.title}</h2>
      </div>
      <button type="button" class="chat-x" aria-label={t.close} data-chat-close>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div class="chat-log" aria-live="polite" data-chat-log>
      <p class="chat-intro">{t.intro}</p>
      <div class="chat-sugs" data-chat-sugs>
        {t.suggestions.map((q) => <button type="button" class="chat-sug">{q}</button>)}
      </div>
    </div>

    <form class="chat-form" data-chat-form>
      <label class="sr" for="chat-input">{t.placeholder}</label>
      <textarea id="chat-input" rows="1" maxlength="600" placeholder={t.placeholder} autocomplete="off" required></textarea>
      <button type="submit" class="btn btn-primary chat-send" aria-label={t.send}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
    <p class="chat-fine">{t.fine}</p>
  </div>
</div>

<script>
  type Turn = { role: 'user' | 'assistant'; content: string };
  const MAX_Q = 6;
  const SAFE_HOSTS = ['ricardodulanto.com', 'calendar.app.google', 'www.linkedin.com', 'linkedin.com', 'github.com'];

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  // Texto plano del modelo → HTML seguro: párrafos, listas con guiones y enlaces solo a destinos conocidos.
  let C: { lang: string; booking: string; thinking: string; error: string; limit: string; book: string };
  function render(text: string): string {
    const link = (s: string) =>
      s
        .replace(/https:\/\/[^\s<)]+[^\s<).,;:!?]/g, (u) => {
          try {
            const h = new URL(u.replace(/&amp;/g, '&')).hostname;
            if (!SAFE_HOSTS.includes(h)) return u;
            const label = h === 'calendar.app.google' ? esc(C.book) : h.endsWith('linkedin.com') ? 'LinkedIn' : u.replace(/^https:\/\/(www\.)?/, '');
            return `<a href="${u}" target="_blank" rel="noopener">${label}</a>`;
          } catch { return u; }
        })
        .replace(/(^|[\s(])(\/(?:en\/)?[a-z0-9-]+(?:\/[a-z0-9-]+)*\/?)(?=$|[\s).,;:!?])/g, (_, pre, p) => `${pre}<a href="${p}">${p}</a>`);
    const blocks = esc(text.replace(/\*\*(.+?)\*\*/g, '$1')).split(/\n{2,}/);
    return blocks
      .map((b) => {
        const lines = b.split('\n').map((l) => l.trim()).filter(Boolean);
        if (lines.length && lines.every((l) => /^[-•*] /.test(l))) {
          return `<ul>${lines.map((l) => `<li>${link(l.replace(/^[-•*] /, ''))}</li>`).join('')}</ul>`;
        }
        return `<p>${link(lines.join('<br>'))}</p>`;
      })
      .join('');
  }

  function track(name: string) {
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    try { g?.('event', name); } catch {}
  }

  document.querySelectorAll<HTMLElement>('[data-chat]').forEach((root) => {
    C = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent!);
    const fab = root.querySelector<HTMLButtonElement>('[data-chat-open]')!;
    const panel = root.querySelector<HTMLElement>('.chat-panel')!;
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!;
    const sugs = root.querySelector<HTMLElement>('[data-chat-sugs]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = form.querySelector('textarea')!;
    const send = form.querySelector<HTMLButtonElement>('button')!;
    const turns: Turn[] = [];
    let busy = false;
    let opened = false;

    const open = () => {
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('on'));
      fab.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
      input.focus();
      if (!opened) { opened = true; track('chat_open'); }
    };
    const close = () => {
      panel.classList.remove('on');
      fab.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      const done = () => { if (!panel.classList.contains('on')) panel.hidden = true; };
      matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 200);
      fab.focus();
    };
    fab.addEventListener('click', () => (panel.hidden ? open() : close()));
    root.querySelector('[data-chat-close]')!.addEventListener('click', close);
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    const bubble = (role: 'user' | 'assistant' | 'note', html: string) => {
      const el = document.createElement('div');
      el.className = `msg ${role}`;
      el.innerHTML = html;
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    };
    const cta = () =>
      `<p><a class="btn btn-ghost chat-book" href="${esc(C.booking)}" target="_blank" rel="noopener">${esc(C.book)}</a></p>`;

    const grow = () => { input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 120)}px`; };
    input.addEventListener('input', grow);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); }
    });

    async function ask(q: string) {
      q = q.trim().slice(0, 600);
      if (!q || busy) return;
      if (turns.filter((x) => x.role === 'user').length >= MAX_Q) {
        bubble('note', `<p>${esc(C.limit)}</p>${cta()}`);
        return;
      }
      busy = true;
      send.disabled = true;
      sugs.remove();
      bubble('user', `<p>${esc(q)}</p>`);
      turns.push({ role: 'user', content: q });
      input.value = '';
      grow();
      const wait = bubble('assistant', `<p class="dots"><span></span><span></span><span></span><span class="sr">${esc(C.thinking)}</span></p>`);
      track('chat_ask');
      try {
        const r = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ lang: C.lang, messages: turns }),
        });
        const data = await r.json().catch(() => ({}));
        if (!r.ok || typeof data.reply !== 'string') throw new Error(data.error || C.error);
        wait.innerHTML = render(data.reply);
        turns.push({ role: 'assistant', content: data.reply });
      } catch (err) {
        turns.pop();
        wait.className = 'msg note';
        wait.innerHTML = `<p>${esc(err instanceof Error && err.message !== 'Failed to fetch' ? err.message : C.error)}</p>${cta()}`;
      } finally {
        busy = false;
        send.disabled = false;
        log.scrollTop = log.scrollHeight;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    sugs.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')));
  });
</script>

<style>
  .chat-fab { position: fixed; right: 24px; bottom: 24px; z-index: 40; display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 20px;
    border: 1px solid var(--ink); border-radius: 999px; background: var(--ink); color: var(--bg); font: inherit; font-size: .92rem; font-weight: 600; cursor: pointer;
    box-shadow: var(--shadow-hover); transition: transform .14s var(--ease-out), background-color .15s ease, opacity .2s ease; }
  .chat-fab svg { color: var(--mark); flex: none; }
  .chat-fab:active { transform: scale(0.97); }
  .chat-fab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .chat-fab:hover { transform: translateY(-2px); } }
  .chat.is-open .chat-fab { opacity: 0; pointer-events: none; }
  /* En móvil, mientras el aviso de cookies está a la vista, el botón no lo tapa. */
  @media (max-width: 720px) { :global(body:has(.consent:not([hidden]))) .chat-fab { opacity: 0; pointer-events: none; } }

  .chat-panel { position: fixed; right: 24px; bottom: 24px; z-index: 60; width: min(400px, calc(100vw - 48px)); height: min(600px, calc(100dvh - 48px));
    display: flex; flex-direction: column; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / .35); opacity: 0; transform: translateY(8px) scale(0.98); transform-origin: bottom right;
    transition: opacity .2s var(--ease-out), transform .2s var(--ease-out); }
  .chat-panel.on { opacity: 1; transform: none; }
  .chat-panel[hidden] { display: none; }

  .chat-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 20px 20px 16px; border-bottom: 1px solid var(--line); }
  .chat-head .eyebrow { margin: 0 0 4px; }
  .chat-head h2 { font-size: 1.1rem; letter-spacing: -0.01em; margin: 0; }
  .chat-x { flex: none; display: inline-grid; place-items: center; width: 44px; height: 44px; margin: -8px -8px 0 0; border: 0; border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer;
    transition: color .15s ease, background-color .15s ease, transform .12s var(--ease-out); }
  .chat-x:active { transform: scale(0.95); }
  .chat-x:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .chat-x:hover { color: var(--ink); background: var(--sand); } }

  .chat-log { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; overscroll-behavior: contain; }
  .chat-intro { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.5; }
  .chat-sugs { display: flex; flex-wrap: wrap; gap: 8px; }
  .chat-sug { min-height: 40px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--ink);
    font: inherit; font-size: .85rem; font-weight: 500; line-height: 1.3; text-align: left; cursor: pointer; transition: border-color .15s ease, background-color .15s ease; }
  .chat-sug:active { transform: scale(0.97); }
  .chat-sug:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .chat-sug:hover { border-color: var(--muted); background: var(--sand); } }

  .chat-log :global(.msg) { max-width: 88%; font-size: .92rem; line-height: 1.5; overflow-wrap: anywhere; }
  .chat-log :global(.msg p) { margin: 0; }
  .chat-log :global(.msg p + p), .chat-log :global(.msg p + ul), .chat-log :global(.msg ul + p) { margin-top: 8px; }
  .chat-log :global(.msg ul) { margin: 0; padding-left: 18px; }
  .chat-log :global(.msg li + li) { margin-top: 4px; }
  .chat-log :global(.msg.user) { align-self: flex-end; padding: 10px 14px; border-radius: 14px 14px 4px 14px; background: var(--ink); color: var(--bg); }
  .chat-log :global(.msg.assistant) { align-self: flex-start; padding: 10px 14px; border-radius: 14px 14px 14px 4px; background: var(--sand); }
  .chat-log :global(.msg.note) { align-self: stretch; max-width: none; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; color: var(--muted); }
  .chat-log :global(.msg a:not(.btn)) { color: var(--link); }
  .chat-log :global(.chat-book) { margin-top: 12px; min-height: 40px; font-size: .85rem; }

  .chat-log :global(.dots) { display: inline-flex; gap: 4px; padding: 4px 0; }
  .chat-log :global(.dots span:not(.sr)) { width: 6px; height: 6px; border-radius: 999px; background: var(--muted); animation: chat-dot 1s ease infinite; }
  .chat-log :global(.dots span:nth-child(2)) { animation-delay: .15s; }
  .chat-log :global(.dots span:nth-child(3)) { animation-delay: .3s; }
  @keyframes chat-dot { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }

  .chat-form { display: flex; align-items: flex-end; gap: 8px; padding: 12px 16px 8px; border-top: 1px solid var(--line); }
  .chat-form textarea { flex: 1; min-height: 44px; max-height: 120px; padding: 11px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--ink);
    font: inherit; font-size: 16px; line-height: 1.35; resize: none; }
  .chat-form textarea::placeholder { color: var(--muted); }
  .chat-form textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .chat-send { flex: none; width: 44px; height: 44px; min-height: 44px; padding: 0; justify-content: center; }
  .chat-send[disabled] { opacity: .5; cursor: not-allowed; }
  .chat-fine { margin: 0; padding: 0 16px 12px; font-size: .72rem; line-height: 1.4; color: var(--muted); }

  @media (max-width: 720px) {
    .chat-fab { right: 16px; bottom: 16px; }
    .chat-panel { right: 0; bottom: 0; left: 0; width: auto; height: min(88dvh, 640px); border-radius: var(--radius) var(--radius) 0 0; border-bottom: 0; transform-origin: bottom center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chat-panel { transform: none; transition: opacity .15s ease; }
    .chat-log :global(.dots span:not(.sr)) { animation: none; opacity: .6; }
  }
  @media print { .chat { display: none; } }
</style>
