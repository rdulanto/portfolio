---
// Tarjeta de consultoría: número, categoría, título, para qué sirve y duración.
import { ui, type Lang } from '../i18n';
import { paths, type Service } from '../data/offer';
const { s, lang } = Astro.props as { s: Service; lang: Lang };
const t = ui[lang].v2;
---
<a class="svc" href={paths.service(lang, s.slug)}>
  <p class="top mono"><span class="n">{s.n}</span><span>{s.cat}</span></p>
  <h3>{s.title}</h3>
  <p class="purpose">{s.purpose}</p>
  <p class="meta mono">{t.duration}: {s.duration}</p>
  <span class="go">{t.seeService} <span class="arrow" aria-hidden="true">→</span></span>
</a>
<style>
  .svc { display: flex; flex-direction: column; gap: 12px; padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); color: var(--ink); text-decoration: none; transition: transform .2s var(--ease-out), border-color .2s ease; min-height: 100%; }
  .top { display: flex; justify-content: space-between; gap: 16px; margin: 0 0 8px; }
  .n { color: var(--accent); }
  h3 { font-size: clamp(1.2rem, 2vw, 1.45rem); margin: 0; }
  .purpose { color: var(--muted); margin: 0; max-width: 46ch; }
  .meta { margin: auto 0 0; padding-top: 16px; border-top: 1px solid var(--line); text-transform: none; }
  .go { color: var(--link); font-weight: 600; font-size: .92rem; display: inline-flex; gap: 6px; align-items: center; min-height: 28px; }
  .arrow { transition: transform .18s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .svc:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); }
    .svc:hover .arrow { transform: translateX(3px); }
  }
  @media (max-width: 720px) { .svc { padding: 24px; } }
</style>
