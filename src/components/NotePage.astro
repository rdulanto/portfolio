---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, BOOKING } from '../config';
import { ui, type Lang } from '../i18n';
import { notesIndex } from '../lib/notes';
const { entry, altHref } = Astro.props;
const lang = entry.data.lang as Lang;
const t = ui[lang];
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-PE' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base lang={lang} title={`${entry.data.title} · Ricardo Dulanto`} description={entry.data.summary} altHref={altHref}>
  <article class="wrap article">
    <a href={notesIndex(lang)} class="back link">{t.backNotes}</a>
    <p class="tags"><span class="cat">{t.cats[entry.data.category as 'guia' | 'investigacion']}</span> · {entry.data.tags.join(' · ')}</p>
    <h1>{entry.data.title}</h1>
    <p class="meta"><time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time> · Ricardo Dulanto</p>
    <div class="prose"><Content /></div>
    <aside class="card cta">
      <p>{t.contactLead}</p>
      <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{t.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
    </aside>
  </article>
</Base>
<style>
  .article { max-width: 720px; padding-top: 40px; padding-bottom: 96px; }
  .back { margin-bottom: 16px; }
  .tags { margin: 0; color: var(--muted); font-family: var(--mono); font-size: .75rem; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; }
  .cat { color: var(--accent); }
  .prose :global(table) { display: table; }
  .prose :global(li) { margin-bottom: 6px; }
  h1 { font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 16px; text-wrap: balance; }
  .meta { color: var(--muted); font-size: .9rem; }
  .prose { font-size: 1.08rem; line-height: 1.75; }
  .prose :global(h2) { font-size: 1.35rem; margin-top: 2em; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); margin: 1.5em 0; padding: 0 0 0 18px; color: var(--muted); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: .95rem; margin: 16px 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .cta { margin-top: 56px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .cta p { flex-basis: 100%; margin: 0 0 4px; }
</style>
