---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import ServiceCard from './ServiceCard.astro';
import { BOOKING, SITE } from '../config';
import { ui, type Lang } from '../i18n';
import { services, courses, paths } from '../data/offer';
import { publishedNotes, notePath, notesIndex } from '../lib/notes';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const v = t.v2;
const projects = (await getCollection('projects', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const notes = (await publishedNotes(lang)).slice(0, 3);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-PE' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const doorHref = [paths.consulting(lang), paths.roles(lang), paths.projects(lang)];
const order = ['services', 'projects', 'courses', ...(notes.length ? ['notes'] : [])];
const idx = (k: string) => String(order.indexOf(k) + 1).padStart(2, '0');
---
<Base lang={lang}>
  <div class="wrap hero">
    <p class="status"><span class="pulse" aria-hidden="true"></span>{t.available}</p>
    <h1>{t.headline}</h1>
    <p class="hero-lead">{t.lead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{t.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={paths.consulting(lang)}>{v.ctaServices}</a>
    </div>
  </div>

  <div class="wrap">
    <nav class="doors" aria-label={lang === 'es' ? 'Por dónde empezar' : 'Where to start'}>
      {v.doors.map((d, i) => (
        <a href={doorHref[i]}>
          <span class="mono">{String(i + 1).padStart(2, '0')} · {d.k}</span>
          <strong>{d.t}</strong>
          <span class="go">{d.cta} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </nav>
    <dl class="proofs">
      {t.proofs.map((p) => (
        <div><dt class="num hl">{p.k}</dt><dd>{p.t}</dd></div>
      ))}
    </dl>
  </div>

  <section id="servicios" class="band">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">{idx('services')} · {t.nav.services}</p><h2>{v.servicesTitle}</h2></div>
        <p class="lead">{v.servicesLead}</p>
      </header>
      <div class="grid svc-grid">
        {services[lang].map((s) => <ServiceCard s={s} lang={lang} />)}
      </div>
      <div class="custom">
        <div><p class="mono">{v.custom.k}</p><h3>{v.custom.t}</h3><p>{v.custom.d}</p></div>
        <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{v.custom.cta} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="proyectos">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">{idx('projects')} · {t.nav.projects}</p><h2>{v.projectsTitle}</h2></div>
        <p class="lead">{t.projectsLead} <a href={paths.projects(lang)}>{v.allProjects}</a></p>
      </header>
      <div class="grid projects">
        {projects.map((p) => <ProjectCard p={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <section id="cursos" class="alt">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">{idx('courses')} · {t.nav.courses}</p><h2>{v.coursesTitle}</h2></div>
        <p class="lead">{v.coursesLead} <a href={paths.courses(lang)}>{v.allCourses}</a></p>
      </header>
      <ul class="course-list">
        {courses[lang].map((c, i) => (
          <li>
            <a href={`${paths.courses(lang)}#${c.id}`}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <strong>{c.title}</strong>
              <span class="mono hrs">{c.hours}</span>
            </a>
          </li>
        ))}
        <li class="custom-course">
          <a href={`${paths.courses(lang)}#a-medida`}>
            <span class="mono">+</span>
            <strong>{v.courseCustom}</strong>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {notes.length > 0 && (
  <section id="blog">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">{idx('notes')} · Blog</p><h2>{v.blogTitle}</h2></div>
        <p class="lead">{v.blogLead} <a href={notesIndex(lang)}>{t.allNotes}</a></p>
      </header>
      <ul class="rows">
        {notes.map((n) => (
          <li>
            <a class="note" href={notePath(lang, n.data.slug)}>
              <time class="mono" datetime={n.data.date.toISOString()}>{fmt.format(n.data.date)}</time>
              <span class="n-text"><h3>{n.data.title}</h3><span class="sum">{n.data.summary}</span></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <section id="contacto" class="band close">
    <div class="wrap">
      <h2>{v.closeTitle}</h2>
      <p class="lead">{v.closeLead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{t.ctaPrimary} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={paths.roles(lang)}>{v.seeRoles}</a>
        <a class="btn btn-ghost" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 104px; padding-bottom: 56px; }
  .hero > * { animation: rise .6s var(--ease-out) both; }
  .hero > :nth-child(2) { animation-delay: 60ms; }
  .hero > :nth-child(3) { animation-delay: 120ms; }
  .hero > :nth-child(4) { animation-delay: 180ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  .status { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 4px 12px 4px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--muted); font-size: .82rem; font-weight: 500; line-height: 1.5; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--mark); box-shadow: 0 0 0 3px color-mix(in srgb, var(--mark) 30%, transparent); flex: none; }
  h1 { font-size: clamp(2.5rem, 6.4vw, 4.75rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.02; max-width: 17ch; margin-bottom: 24px; text-wrap: balance; }
  .hero-lead { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.5; color: var(--muted); max-width: 56ch; margin: 0 0 40px; }
  .arrow { display: inline-block; transition: transform .18s var(--ease-out); }

  /* Tres puertas */
  .doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); overflow: hidden; }
  .doors a { display: flex; flex-direction: column; gap: 12px; padding: 24px 28px; color: var(--ink); text-decoration: none; transition: background-color .15s ease; }
  .doors a + a { border-left: 1px solid var(--line); }
  .doors strong { font-size: 1.1rem; font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; }
  .doors .go { margin-top: auto; color: var(--link); font-weight: 600; font-size: .92rem; display: inline-flex; gap: 6px; }
  @media (hover: hover) and (pointer: fine) { .doors a:hover { background: var(--sand); } .doors a:hover .arrow { transform: translateX(3px); } }

  .proofs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 24px 0 88px; }
  .proofs div { padding: 8px 32px 8px 0; }
  .proofs div + div { padding-left: 32px; border-left: 1px solid var(--line); }
  .proofs dt { font-size: clamp(2rem, 3.6vw, 2.75rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05; margin-bottom: 12px; }
  .proofs dd { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.5; max-width: 34ch; }

  .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .custom { margin-top: 24px; display: flex; gap: 24px 48px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 32px; border: 1px dashed var(--line); border-radius: var(--radius); }
  .custom h3 { margin: 8px 0; font-size: 1.25rem; }
  .custom p:not(.mono) { margin: 0; color: var(--muted); max-width: 60ch; }
  .custom .mono { margin: 0; color: var(--accent); }

  .projects { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .course-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; border-top: 1px solid var(--ink); }
  .course-list li { border-bottom: 1px solid var(--line); }
  .course-list a { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 20px 0; color: var(--ink); text-decoration: none; }
  .course-list strong { font-weight: 600; transition: color .15s ease; }
  .custom-course .mono, .custom-course .arrow { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) { .course-list a:hover strong { text-decoration: underline; text-decoration-color: var(--mark); text-decoration-thickness: 2px; text-underline-offset: 4px; } }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows > li { border-bottom: 1px solid var(--line); }
  .note { display: grid; grid-template-columns: 160px minmax(0, 1fr) auto; gap: 8px 32px; align-items: baseline; padding: 24px 0; color: inherit; text-decoration: none; }
  .n-text h3 { margin: 0 0 4px; transition: color .15s ease; }
  .sum { color: var(--muted); font-size: .95rem; }
  .note .arrow { color: var(--link); }
  @media (hover: hover) and (pointer: fine) { .note:hover h3 { text-decoration: underline; text-decoration-color: var(--mark); text-decoration-thickness: 2px; text-underline-offset: 4px; } .note:hover .arrow { transform: translateX(3px); } }

  .close h2 { font-size: clamp(2rem, 4.4vw, 3.25rem); letter-spacing: -0.03em; margin-bottom: 16px; max-width: 18ch; }
  .close .lead { margin-bottom: 32px; }

  @media (max-width: 960px) {
    .hero { padding-top: 72px; }
    .doors { grid-template-columns: 1fr; }
    .doors a + a { border-left: 0; border-top: 1px solid var(--line); }
    .projects { grid-template-columns: 1fr 1fr; }
    .course-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .hero { padding-top: 40px; padding-bottom: 40px; }
    .status { border: 0; background: none; padding: 0; align-items: flex-start; }
    .pulse { margin-top: 7px; }
    .proofs { grid-template-columns: 1fr; margin-bottom: 64px; }
    .proofs div, .proofs div + div { padding: 16px 0; border-left: 0; border-top: 1px solid var(--line); }
    .svc-grid, .projects { grid-template-columns: 1fr; }
    .custom { padding: 24px; }
    .custom .btn { width: 100%; }
    .note { grid-template-columns: minmax(0, 1fr) auto; }
    .note time { grid-column: 1 / -1; }
  }
</style>
