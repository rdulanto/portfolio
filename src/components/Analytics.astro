---
import { SITE } from '../config';
import { ui, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].consent;
const gaId = SITE.gaId;
---
{gaId && (
  <div id="consent" class="consent" hidden data-ga={gaId}>
    <p>{t.text}</p>
    <div>
      <button type="button" class="btn btn-ghost" data-choice="no">{t.no}</button>
      <button type="button" class="btn btn-primary" data-choice="yes">{t.yes}</button>
    </div>
  </div>
)}
<script>
  // GA4 se carga solo después de que el visitante acepta. Sin consentimiento no hay cookies.
  const box = document.getElementById('consent');
  if (box) {
    const id = box.dataset.ga!;
    const KEY = 'analytics-consent';
    const load = () => {
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
      document.head.appendChild(s);
      const w = window as any;
      w.dataLayer = w.dataLayer || [];
      w.gtag = function () { w.dataLayer.push(arguments); };
      w.gtag('js', new Date());
      w.gtag('config', id, { anonymize_ip: true });
    };
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (saved === 'yes') load();
    else if (saved !== 'no') box.hidden = false;
    box.addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).dataset.choice;
      if (!c) return;
      try { localStorage.setItem(KEY, c); } catch {}
      box.hidden = true;
      if (c === 'yes') load();
    });
  }
</script>
<style>
  .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; max-width: 560px; margin: 0 auto; z-index: 50;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,.08); display: flex; gap: 16px; align-items: center; flex-wrap: wrap; font-size: .9rem; }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; flex: 1 1 260px; }
  .consent div { display: flex; gap: 8px; }
  .consent .btn { padding: 8px 14px; font-size: .85rem; }
</style>
