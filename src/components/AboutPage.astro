---
import Base from '../layouts/Base.astro';
import { BOOKING, SITE } from '../config';
import { ui, type Lang } from '../i18n';
import { paths } from '../data/offer';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const v = t.v2;
---
<Base lang={lang} title={`${v.aboutTitle} · Ricardo Dulanto`} description={v.aboutLead} altHref={lang === 'es' ? '/en/about/' : '/sobre-mi/'} image="/img/ricardo-dulanto-sobre-mi.jpg">
  <header class="wrap page-head head-grid">
    <div>
      <p class="eyebrow">{t.nav.about}</p>
      <h1>Ricardo Dulanto</h1>
      <p class="lead strong">{v.aboutLead}</p>
      {v.aboutBody.map((p) => <p class="lead">{p}</p>)}
      <div class="ctas">
        <a class="btn btn-primary" href={BOOKING} rel="noopener" target="_blank">{t.ctaPrimary} <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
    <picture class="portrait">
      <source srcset="/img/ricardo-dulanto-sobre-mi.webp" type="image/webp" />
      <img src="/img/ricardo-dulanto-sobre-mi.jpg" alt={lang === 'es' ? 'Ricardo Dulanto trabajando con su laptop' : 'Ricardo Dulanto working on his laptop'} width="800" height="1000" />
    </picture>
  </header>

  <section>
    <div class="wrap">
      <header class="sec-head"><div><p class="eyebrow">01 · {v.stagesTitle}</p><h2>{v.stagesTitle}</h2></div></header>
      <ol class="stages">
        {v.stages.map((s, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{s.k}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">02 · {t.caseTitle}</p><h2>{t.caseTitle}</h2></div>
        <p class="lead"><strong>{t.case.org}</strong><br />{t.case.role}</p>
      </header>
      <div class="case">
        <div><p class="mono">{t.case.labels.problem}</p><p>{t.case.problem}</p></div>
        <div><p class="mono">{t.case.labels.did}</p><ul>{t.case.did.map((d) => <li>{d}</li>)}</ul></div>
        <div><p class="mono">{t.case.labels.result}</p><p>{t.case.result}</p></div>
      </div>
    </div>
  </section>

  <section id="credenciales">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="eyebrow">03 · {t.credTitle}</p><h2>{t.credTitle}</h2></div>
        <p class="lead">{t.credLead}</p>
      </header>
      <div class="creds">
        {t.credGroups.map((g) => <div><p class="mono">{g.k}</p><ul>{g.items.map((c) => <li>{c}</li>)}</ul></div>)}
      </div>
      <p class="more"><a href={paths.roles(lang)}>{t.v2.seeRoles} →</a> · <a href={paths.courses(lang)}>{t.v2.allCourses} →</a></p>
    </div>
  </section>
</Base>
<style>
  .head-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .lead.strong { color: var(--ink); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; }
  .head-grid .lead + .lead { margin-top: 16px; }
  .portrait img { width: 100%; max-width: 360px; margin-left: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .stages li { border-top: 1px solid var(--ink); padding-top: 16px; }
  .stages .mono { color: var(--accent); }
  .stages h3 { margin: 12px 0 8px; }
  .stages p { margin: 0; color: var(--muted); font-size: .95rem; }
  .sec-head .lead strong { color: var(--ink); }
  .case { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .case > div { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .case .mono { margin: 0 0 12px; color: var(--accent); }
  .case p:not(.mono), .case li { color: var(--muted); font-size: .95rem; margin: 0; }
  .case ul { padding-left: 18px; margin: 0; display: grid; gap: 8px; }
  .creds { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .creds > div { border-top: 1px solid var(--ink); padding-top: 16px; }
  .creds .mono { margin: 0 0 12px; color: var(--accent); }
  .creds ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: .95rem; }
  .more { margin: 48px 0 0; font-weight: 600; }
  @media (max-width: 960px) { .stages, .creds { grid-template-columns: 1fr 1fr; } .case { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .head-grid { grid-template-columns: 1fr; }
    .portrait { order: -1; }
    .portrait img { max-width: 200px; margin: 0; }
    .stages, .creds { grid-template-columns: 1fr; }
  }
</style>
