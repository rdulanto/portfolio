---
import { getCollection } from 'astro:content';
import ProjectPage from '../../../components/ProjectPage.astro';
export async function getStaticPaths() {
  const all = await getCollection('projects');
  const es = all.filter((p) => p.data.lang === 'es');
  return all.filter((p) => p.data.lang === 'en').map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, altHref: es[i] ? `/proyectos/${es[i].data.slug}/` : '/' },
  }));
}
const { entry, altHref } = Astro.props;
---
<ProjectPage entry={entry} altHref={altHref} />
