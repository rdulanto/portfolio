---
import { getCollection } from 'astro:content';
import ProjectPage from '../../../components/ProjectPage.astro';
export async function getStaticPaths() {
  const all = await getCollection('projects');
  const alt = (ref: string) => all.find((p) => p.data.lang === 'es' && p.data.ref === ref);
  return all.filter((p) => p.data.lang === 'en').map((entry) => {
    const pair = alt(entry.data.ref);
    return { params: { slug: entry.data.slug }, props: { entry, altHref: pair ? `/proyectos/${pair.data.slug}/` : '/' } };
  });
}
const { entry, altHref } = Astro.props;
---
<ProjectPage entry={entry} altHref={altHref} />
