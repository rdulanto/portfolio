---
import NotePage from '../../../components/NotePage.astro';
import { publishedNotes } from '../../../lib/notes';
export async function getStaticPaths() {
  const all = await publishedNotes();
  return all.filter((n) => n.data.lang === 'en').map((entry) => {
    const pair = all.find((p) => p.data.lang === 'es' && p.data.ref === entry.data.ref);
    return { params: { slug: entry.data.slug }, props: { entry, altHref: pair ? `/blog/${pair.data.slug}/` : '/blog/' } };
  });
}
const { entry, altHref } = Astro.props;
---
<NotePage entry={entry} altHref={altHref} />
